{
  "openapi": "3.1.0",
  "info": {
    "title": "ContextLab REST API",
    "version": "0.1.0",
    "description": "Initial REST contract for ContextLab context engineering discovery APIs."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3100",
      "description": "Default local API server"
    }
  ],
  "tags": [
    {
      "name": "Platform"
    },
    {
      "name": "Discovery"
    },
    {
      "name": "Context Graph"
    },
    {
      "name": "Providers"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "tags": ["Platform"],
        "summary": "Return API health.",
        "responses": {
          "200": {
            "description": "API is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "getMeta",
        "tags": ["Platform"],
        "summary": "Return platform metadata for clients and SDKs.",
        "responses": {
          "200": {
            "description": "Platform metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "tags": ["Platform"],
        "summary": "Return the checked-in OpenAPI contract served by the API.",
        "responses": {
          "200": {
            "description": "OpenAPI contract document.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiDocument"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/providers": {
      "get": {
        "operationId": "listProviders",
        "tags": ["Providers"],
        "summary": "Return configured model provider status without exposing secrets.",
        "responses": {
          "200": {
            "description": "Provider readiness status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "tags": ["Discovery"],
        "summary": "List workspaces with pagination, filtering, and sorting.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/WorkspaceSort"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/projects": {
      "get": {
        "operationId": "listProjects",
        "tags": ["Discovery"],
        "summary": "List projects for one workspace.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ProjectSort"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/experiments": {
      "get": {
        "operationId": "listExperiments",
        "tags": ["Discovery"],
        "summary": "List experiments for one project.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ExperimentSort"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Experiment list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/contexts": {
      "get": {
        "operationId": "listContexts",
        "tags": ["Discovery"],
        "summary": "List contexts for one project.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "name": "experiment_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ContextSort"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Context list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/contexts/{context_id}/commits": {
      "get": {
        "operationId": "listCommits",
        "tags": ["Discovery"],
        "summary": "List commits for one context.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContextId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "name": "branch_name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/CommitSort"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commit list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommitListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/contexts/{context_id}/commits/{commit_id}": {
      "get": {
        "operationId": "getCommit",
        "tags": ["Discovery"],
        "summary": "Get one context commit.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContextId"
          },
          {
            "$ref": "#/components/parameters/CommitId"
          }
        ],
        "responses": {
          "200": {
            "description": "Commit detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommitDetail"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/contexts/{context_id}/components": {
      "get": {
        "operationId": "listComponents",
        "tags": ["Discovery"],
        "summary": "List components for one context.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContextId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ComponentKind"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ComponentSort"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Component list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/contexts/{context_id}/components/{component_id}": {
      "get": {
        "operationId": "getComponent",
        "tags": ["Discovery"],
        "summary": "Get one context component.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContextId"
          },
          {
            "$ref": "#/components/parameters/ComponentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Component detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentDetail"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/contexts/{context_id}/evaluation-runs": {
      "get": {
        "operationId": "listEvaluationRuns",
        "tags": ["Discovery"],
        "summary": "List evaluation runs for one context.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContextId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "name": "suite_name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "model_version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/EvaluationRunSort"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluation run list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationRunListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/contexts/{context_id}/evaluation-scorecard": {
      "get": {
        "operationId": "getEvaluationScorecard",
        "tags": ["Discovery"],
        "summary": "Get a context-level evaluation scorecard.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContextId"
          },
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "name": "suite_name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "model_version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluation scorecard.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationScorecard"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/contexts/{context_id}/evaluation-runs/{run_id}": {
      "get": {
        "operationId": "getEvaluationRun",
        "tags": ["Discovery"],
        "summary": "Get one evaluation run for one context.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContextId"
          },
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluation run detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationRunDetail"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/graph-diffs": {
      "post": {
        "operationId": "compareGraphs",
        "tags": ["Context Graph"],
        "summary": "Compare two explicit Context Graph snapshots without persisting them.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphDiffRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deterministic structural graph diff.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphDiffResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/v1/context-graph/preview": {
      "get": {
        "operationId": "getContextGraphPreview",
        "tags": ["Context Graph"],
        "summary": "Return a deterministic Context Graph preview.",
        "responses": {
          "200": {
            "description": "Context Graph preview.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextGraphResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/context-graph": {
      "get": {
        "operationId": "getWorkspaceContextGraph",
        "tags": ["Context Graph"],
        "summary": "Return a Context Graph for one workspace.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkspaceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace Context Graph.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextGraphResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "WorkspaceId": {
        "name": "workspace_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ProjectId": {
        "name": "project_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ContextId": {
        "name": "context_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "CommitId": {
        "name": "commit_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ComponentId": {
        "name": "component_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RunId": {
        "name": "run_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "Search": {
        "name": "search",
        "in": "query",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request parameters.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Requested storage scope was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "A requested commit exists but its graph snapshot is not materialized.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Server or storage contract error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "MetaResponse": {
        "type": "object",
        "required": ["product", "primary_abstraction", "bilingual", "context_component_kinds", "capabilities"],
        "properties": {
          "product": {
            "type": "string"
          },
          "primary_abstraction": {
            "type": "string"
          },
          "bilingual": {
            "type": "boolean"
          },
          "context_component_kinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProvidersResponse": {
        "type": "object",
        "required": ["providers"],
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderStatus"
            }
          }
        }
      },
      "ProviderStatus": {
        "type": "object",
        "required": ["id", "display_name", "configured", "base_url", "api_key_env", "api_key_fingerprint"],
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "configured": {
            "type": "boolean"
          },
          "base_url": {
            "type": "string",
            "format": "uri"
          },
          "api_key_env": {
            "type": "string"
          },
          "api_key_fingerprint": {
            "type": ["string", "null"]
          }
        }
      },
      "ListPagination": {
        "type": "object",
        "required": ["page", "per_page", "total"],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "WorkspaceItem": {
        "type": "object",
        "required": ["id", "name", "slug", "created_at"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectItem": {
        "type": "object",
        "required": ["id", "workspace_id", "name", "slug", "created_at"],
        "properties": {
          "id": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ExperimentItem": {
        "type": "object",
        "required": ["id", "project_id", "name", "branch_name", "created_at"],
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "branch_name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContextItem": {
        "type": "object",
        "required": ["id", "project_id", "experiment_id", "name", "description", "created_at"],
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "experiment_id": {
            "type": ["string", "null"]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CommitItem": {
        "type": "object",
        "required": ["id", "context_id", "branch_name", "message", "parent_commit_ids", "change_count", "authored_at", "created_at"],
        "properties": {
          "id": {
            "type": "string"
          },
          "context_id": {
            "type": "string"
          },
          "branch_name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "parent_commit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "change_count": {
            "type": "integer",
            "minimum": 0
          },
          "authored_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CommitDetail": {
        "type": "object",
