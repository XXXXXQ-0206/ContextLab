{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@contextlab/design-system": ["packages/design-system/src/index.ts"],
      "@contextlab/local-sdk": ["packages/local-sdk/src/index.ts"],
      "@contextlab/ts-sdk": ["packages/ts-sdk/src/index.ts"],
      "@contextlab/ui": ["packages/ui/src/index.ts"]
    }
  }
}
