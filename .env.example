CONTEXTLAB_ENV=development
CONTEXTLAB_API_HOST=127.0.0.1
CONTEXTLAB_API_PORT=3100
CONTEXTLAB_API_ROUTE_MODE=public
CONTEXTLAB_GRAPH_REPOSITORY=memory
CONTEXTLAB_DATABASE_URL=

# Required only when CONTEXTLAB_API_ROUTE_MODE=protected.
# Protected mode requires CONTEXTLAB_GRAPH_REPOSITORY=postgres.
# `hmac` is the default mode; choose `oidc` for RS256 JWTs from an HTTPS JWKS endpoint.
# The exact validated issuer is the identity source; it must remain stable for one trust domain.
# ContextLab combines that source with the opaque, case-sensitive JWT `sub` before authorization.
# 精确校验后的 issuer 是 identity source，并且必须在一个信任域内保持稳定。
# ContextLab 会先把该 source 与不透明、大小写敏感的 JWT `sub` 组合，再进行 authorization。
CONTEXTLAB_AUTH_MODE=hmac
CONTEXTLAB_AUTH_HS256_SECRET=
CONTEXTLAB_AUTH_ISSUER=
CONTEXTLAB_AUTH_AUDIENCE=
CONTEXTLAB_OIDC_ISSUER=
CONTEXTLAB_OIDC_AUDIENCE=
CONTEXTLAB_OIDC_JWKS_URL=
CONTEXTLAB_OIDC_JWKS_CACHE_TTL_SECONDS=

# Optional together only for protected OIDC group-to-role resolution.
# The configured top-level claim is validated after token verification; its lifetime must be 1..=3600 seconds.
# 仅在 protected OIDC 的 group-to-role 解析中成对配置。
# 配置的顶层 claim 会在 token 校验后处理，其最大生命周期必须是 1..=3600 秒。
CONTEXTLAB_OIDC_GROUPS_CLAIM=
CONTEXTLAB_OIDC_MAX_TOKEN_LIFETIME_SECONDS=

# Required only when CONTEXTLAB_API_ROUTE_MODE=protected.
# Valid ranges: requests 1..=1000, window seconds 1..=3600, tracked principal identities 1..=100000.
# 仅在 CONTEXTLAB_API_ROUTE_MODE=protected 时必需。
# 有效范围：请求数 1..=1000，窗口秒数 1..=3600，追踪的主体身份数 1..=100000。
CONTEXTLAB_PROTECTED_RATE_LIMIT_MAX_REQUESTS=
CONTEXTLAB_PROTECTED_RATE_LIMIT_WINDOW_SECONDS=
CONTEXTLAB_PROTECTED_RATE_LIMIT_MAX_TRACKED_PRINCIPALS=
RUST_LOG=contextlab_api=info,tower_http=info

# Provider credentials are read from local .env files.
# Never commit real API keys.
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# Point this at any OpenAI-compatible endpoint you operate, for example a local gateway.
# 请指向你自己运营的任意 OpenAI-compatible endpoint，例如本地 gateway。
OPENAI_COMPAT_API_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPAT_API_KEY=
